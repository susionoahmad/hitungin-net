{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/id",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/id/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!ads\\.txt|sitemap\\.xml|robots\\.txt|site\\.webmanifest|favicon\\.svg|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}

