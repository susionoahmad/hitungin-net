{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/id",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/id/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/en",
      "destination": "/spa.html"
    },
    {
      "source": "/en/:path*",
      "destination": "/spa.html"
    },
    {
      "source": "/admin",
      "destination": "/spa.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/spa.html"
    },
    {
      "source": "/check-email",
      "destination": "/spa.html"
    },
    {
      "source": "/reset-password",
      "destination": "/spa.html"
    }
  ]
}
